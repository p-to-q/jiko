# Runtime selection
APP_RUNTIME=laptop
STT_PROVIDER=sherpa-onnx
TTS_PROVIDER=clip

# Local server
PORT=4317
HOST=127.0.0.1
JIKO_WRITE_RECEIPTS=1
JIKO_HTTP_HEADERS_TIMEOUT_MS=10000
JIKO_HTTP_REQUEST_TIMEOUT_MS=15000
JIKO_HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
JIKO_HTTP_MAX_REQUESTS_PER_SOCKET=100
# Browser HTTP/SSE requests use exact Origin matches. Native/CLI clients may
# omit Origin and remain accepted; loopback is the boundary. This is browser
# isolation, not LAN client authentication.
JIKO_HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
JIKO_SSE_MAX_CONNECTIONS=32
JIKO_SESSION_MAX_COUNT=256
JIKO_SESSION_IDLE_TTL_MS=600000
JIKO_SESSION_TERMINAL_RETENTION_MS=86400000
# Retired IDs remain unavailable across client retries for at least the receipt
# lifetime. This must be >= JIKO_RECEIPT_RETENTION_MS or startup fails. The
# bounded ledger refuses new attempts instead of dropping live protection.
JIKO_SESSION_ID_RETRY_HORIZON_MS=604800000
JIKO_SESSION_TOMBSTONE_MAX_COUNT=4096
JIKO_RECEIPT_MAX_FILES=512
JIKO_RECEIPT_MAX_FILE_BYTES=1048576
JIKO_RECEIPT_MAX_TOTAL_BYTES=67108864
JIKO_RECEIPT_RETENTION_MS=604800000
# Ordered browser PCM ingress. Origins are exact matches; do not use a wildcard.
JIKO_ORDERED_PCM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
JIKO_ORDERED_PCM_MAX_SPOOL_BYTES=12582912
JIKO_ORDERED_PCM_MAX_WAL_BYTES=4194304
JIKO_ORDERED_PCM_MAX_CHUNKS=12000
JIKO_ORDERED_PCM_CAPTURE_TIMEOUT_MS=120000
JIKO_ORDERED_PCM_START_TIMEOUT_MS=10000
JIKO_ORDERED_PCM_MAX_CONNECTIONS=8
# Shared process-wide admission. HTTP upload ingress accounts for both retained
# chunks and the contiguous joined body; ordered PCM accounts for spool/WAL
# bytes. Pipeline limits are checked before normalization/STT.
JIKO_AUDIO_MAX_INGRESS_BYTES=25165824
JIKO_AUDIO_MAX_INGRESS_LEASES=16
JIKO_AUDIO_MAX_PIPELINE_BYTES=25165824
JIKO_AUDIO_MAX_PIPELINES=1
# Hard decoded mono-16-kHz ceiling for every HTTP and ordered-PCM turn.
JIKO_AUDIO_MAX_DURATION_MS=120000

# Local/self-hosted speech services
FUNASR_ENDPOINT=http://127.0.0.1:10095
PIPER_BIN=piper
PIPER_VOICE=
TTS_CLIP_DIR=local-clips
TTS_PLAY_AUDIO=0
TTS_PLAY_COMMAND=
# Optional ritual delay before local TTS starts. The current three-lamp reveal
# locks at 0/450/900 ms; this default starts playback after the final lock.
TTS_AFTER_RESULT_DELAY_MS=900
TTS_GENERATE_COMMAND=say
TTS_GENERATE_VOICE=
TTS_GENERATE_EXTENSION=
TTS_GENERATE_ARGS=
# Local STT via whisper.cpp. Set STT_PROVIDER=whisper.cpp and point these at a
# whisper.cpp build + ggml model. The server loads apps/server/.env automatically
# (node --env-file-if-exists). Example (sibling whisper.cpp build):
#   STT_PROVIDER=whisper.cpp
#   WHISPER_CPP_BIN=/abs/path/to/whisper.cpp/build/bin/whisper-cli
#   WHISPER_MODEL=/abs/path/to/whisper.cpp/models/ggml-large-v3-turbo.bin
WHISPER_CPP_BIN=
WHISPER_MODEL=
# 'auto' detects language; 'zh' pins Simplified Chinese.
WHISPER_LANGUAGE=auto
SHERPA_ONNX_PYTHON=.venv/bin/python
SHERPA_ONNX_SENSEVOICE_MODEL=/path/to/sherpa-sensevoice/model.onnx
SHERPA_ONNX_SENSEVOICE_TOKENS=/path/to/sherpa-sensevoice/tokens.txt
SHERPA_ONNX_LANGUAGE=auto
SHERPA_ONNX_THREADS=4
SHERPA_ONNX_PROVIDER=cpu
# Preserve the faithful transcript by default. A 2026-09-18 synthetic host
# spike found an English deletion with SenseVoice ITN enabled; any semantic ITN
# pass must be separately versioned and benchmarked.
SHERPA_ONNX_USE_ITN=0
# Optional persistent worker overrides. Readiness waits for model load and
# SHA-256 identity; live decoding stays single-flight by default.
SHERPA_ONNX_WORKER_SCRIPT=
SHERPA_ONNX_STARTUP_TIMEOUT_MS=60000
SHERPA_ONNX_MAX_PENDING_REQUESTS=1

# Optional third-party, pre-recorded batch STT challenger. This adapter is not
# approved for live use under the checked-in release policy. After a separate
# written approval, audio is sent only when STT_PROVIDER=deepgram,
# JIKO_ALLOW_REMOTE_AUDIO=1, and that individual audio request explicitly names
# Deepgram consent. The browser client does not add that consent automatically.
JIKO_ALLOW_REMOTE_AUDIO=0
DEEPGRAM_API_KEY=
DEEPGRAM_ENDPOINT=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
# Required when enabled. Pin an explicit provider version; "latest" is rejected.
DEEPGRAM_VERSION=
DEEPGRAM_LANGUAGE=multi

STT_TIMEOUT_MS=15000
FFMPEG_BIN=ffmpeg
AUDIO_NORMALIZE_TIMEOUT_MS=15000
# Monotonic release/request-to-terminal ceiling. The reserve ends STT early so
# measured voice/timing evidence can still be composed and committed.
SESSION_DEADLINE_MS=4000
SESSION_RESULT_COMMIT_RESERVE_MS=750

# Manual/demo fallback
MANUAL_PROVIDER_ENABLED=1
DEMO_OPERATOR_KEY=

# Public site waitlist storage. Use a hosted Postgres/Neon URL in Vercel env.
DATABASE_URL=
POSTGRES_URL=
WAITLIST_BASE_COUNT=0

# Raspberry Pi hardware adapter
GPIO_RECORD_BUTTON_PIN=17
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=
