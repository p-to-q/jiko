{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jiko.local/schemas/stt-provider-identity-v1.schema.json",
  "title": "Jiko self-hosted STT provider identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providerId", "runtime", "configurationId", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "stt_provider_identity_v1" },
    "providerId": { "const": "self-hosted:funasr-http:loopback" },
    "runtime": { "type": "string", "minLength": 1 },
    "configurationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "path", "sha256", "bytes"],
        "properties": {
          "role": { "enum": ["runtime", "worker", "model", "tokens", "configuration"] },
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
