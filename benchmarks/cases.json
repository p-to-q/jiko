          "durationMs": 5000,
          "speechMs": 2100,
          "preSpeechDelayMs": 1500,
          "pauseCount": 4,
          "longestPauseMs": 1100
        }
      },
      "expectedStates": {
        "text": "maintain",
        "voice": "maintain",
        "timing": "maintain"
      },
      "expectedResult": {
        "topWindowStatus": "consensus_maintain",
        "majorityState": "maintain",
        "unavailableChannels": [],
        "hasTts": true
      }
    },
