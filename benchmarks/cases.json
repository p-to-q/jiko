{
  "schemaVersion": 4,
  "suite": "jiko-readings-and-coverage-structural-v4",
  "measurement": {
    "scope": "warmed in-process shared-core microbenchmark",
    "warmupIterations": 100,
    "measuredIterations": 1000
  },
  "cases": [
    {
      "id": "clear-deviate-zh",
      "input": {
        "text": {
          "transcript": "我想离开这里，开始改变",
          "language": "zh"
        },
        "voice": {
          "durationMs": 4000,
          "speechMs": 3300,
          "silenceMs": 700,
          "pauseCount": 1,
          "longestPauseMs": 300,
          "rmsMean": 0.12,
          "rmsStd": 0.05,
          "rmsPeak": 0.35,
          "pitchStdHz": 50
        },
        "timing": {
          "durationMs": 4000,
          "speechMs": 3300,
          "preSpeechDelayMs": 200,
          "pauseCount": 1,
          "longestPauseMs": 300
        }
      },
      "expectedStates": {
        "text": "deviate",
        "voice": "deviate",
        "timing": "deviate"
      },
      "expectedResult": {
        "topWindowStatus": "consensus_deviate",
        "majorityState": "deviate",
        "unavailableChannels": [],
        "hasTts": true
      }
    },
    {
      "id": "clear-maintain-zh",
      "input": {
        "text": {
          "transcript": "还是先别做，晚点再说，保持安全",
          "language": "zh"
        },
        "voice": {
          "durationMs": 5000,
          "speechMs": 2100,
          "silenceMs": 2900,
          "pauseCount": 4,
          "longestPauseMs": 1100,
          "rmsMean": 0.04,
          "rmsStd": 0.008,
          "rmsPeak": 0.1,
          "pitchStdHz": 10
        },
        "timing": {
          "durationMs": 5000,
          "speechMs": 2100,
          "preSpeechDelayMs": 1500,
          "pauseCount": 4,
          "longestPauseMs": 1100
        }
      },
      "expectedStates": {
        "text": "maintain",
        "voice": "maintain",
        "timing": "maintain"
      },
      "expectedResult": {
        "topWindowStatus": "consensus_maintain",
        "majorityState": "maintain",
        "unavailableChannels": [],
        "hasTts": true
      }
    },
