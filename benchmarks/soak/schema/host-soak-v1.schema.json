{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jiko:benchmark:host-soak-v1",
  "title": "Jiko host software soak receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "runId",
    "evidenceClass",
    "harnessStatus",
    "disclaimer",
    "startedAt",
    "finishedAt",
    "elapsedMonotonicMs",
    "source",
    "environment",
    "configuration",
    "coverage",
    "campaign",
    "integrity",
    "measurements",
    "cases",
    "qualification",
    "privacy",
    "errors",
    "omittedErrorCount"
  ],
  "properties": {
    "schema": { "const": "host_soak_v1" },
    "schemaVersion": { "const": 1 },
    "runId": { "$ref": "#/$defs/safeId" },
    "evidenceClass": { "const": "host_software" },
    "harnessStatus": { "enum": ["completed", "failed", "error"] },
    "disclaimer": {
      "const": "Host software HTTP/SSE/session/receipt evidence only; not hardware, physical capture, STT-quality, power, or thermal evidence."
    },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "finishedAt": { "$ref": "#/$defs/timestamp" },
    "elapsedMonotonicMs": { "type": "number", "minimum": 0 },
    "source": { "$ref": "#/$defs/source" },
    "environment": { "$ref": "#/$defs/environment" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "campaign": { "$ref": "#/$defs/campaign" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "measurements": { "$ref": "#/$defs/measurements" },
    "cases": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/case" }
    },
    "qualification": { "$ref": "#/$defs/qualification" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "errors": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "turn": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "code": { "$ref": "#/$defs/safeId" },
          "message": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "omittedErrorCount": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    },
    "gitIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "sha", "dirty"],
          "properties": {
            "availability": { "const": "identified" },
            "sha": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
            "dirty": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "reason"],
          "properties": {
            "availability": { "const": "unavailable" },
            "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git",
        "lockfileSha256",
        "schemaSha256",
        "validatorSha256",
        "harnessSha256",
        "serverEntrySha256",
        "configurationSha256"
      ],
      "properties": {
        "git": { "$ref": "#/$defs/gitIdentity" },
        "lockfileSha256": { "$ref": "#/$defs/sha256" },
        "schemaSha256": { "$ref": "#/$defs/sha256" },
        "validatorSha256": { "$ref": "#/$defs/sha256" },
        "harnessSha256": { "$ref": "#/$defs/sha256" },
        "serverEntrySha256": { "$ref": "#/$defs/sha256" },
        "configurationSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "platform", "release", "arch", "node", "serverPid"],
      "properties": {
        "kind": { "const": "host" },
        "platform": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "node": { "type": "string", "minLength": 1 },
        "serverPid": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannedTurns",
        "audioEvery",
        "replayEvery",
        "startupTimeoutMs",
        "turnTimeoutMs",
        "sessionDeadlineMs",
        "resultCommitReserveMs",
        "rssSampleEvery",
        "keepSessionReceipts",
        "server",
        "syntheticAudio"
      ],
      "properties": {
        "plannedTurns": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "audioEvery": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "replayEvery": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "startupTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "turnTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
        "sessionDeadlineMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
        "resultCommitReserveMs": { "type": "integer", "minimum": 1, "maximum": 59999 },
        "rssSampleEvery": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "keepSessionReceipts": { "type": "boolean" },
        "server": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runtime", "transport", "receiptWriting", "stt", "ttsPlayback"],
          "properties": {
            "runtime": { "const": "spawned_node_process" },
            "transport": { "const": "localhost_http_sse" },
            "receiptWriting": { "const": true },
            "stt": { "const": "disabled" },
            "ttsPlayback": { "const": "disabled" }
          }
        },
        "syntheticAudio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generatedInMemory",
            "mediaType",
            "durationMs",
            "sampleRateHz",
            "channelCount",
            "sampleFormat"
          ],
          "properties": {
            "generatedInMemory": { "const": true },
            "mediaType": { "const": "audio/wav" },
            "durationMs": { "type": "integer", "minimum": 100, "maximum": 5000 },
            "sampleRateHz": { "const": 16000 },
            "channelCount": { "const": 1 },
            "sampleFormat": { "const": "pcm_s16le" }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeHttpServer",
        "http",
        "sseLive",
        "sseReplay",
        "receiptEndpoint",
        "receiptDisk",
        "manualTurns",
        "syntheticAudioTurns",
        "recordingStartStopTurns",
        "duplicateCreateProbes",
        "duplicateFinalSubmissionProbes",
        "sseReplayProbes",
        "excluded"
      ],
      "properties": {
        "nodeHttpServer": { "type": "boolean" },
        "http": { "type": "boolean" },
        "sseLive": { "type": "boolean" },
        "sseReplay": { "type": "boolean" },
        "receiptEndpoint": { "type": "boolean" },
        "receiptDisk": { "type": "boolean" },
        "manualTurns": { "type": "integer", "minimum": 0 },
        "syntheticAudioTurns": { "type": "integer", "minimum": 0 },
        "recordingStartStopTurns": { "type": "integer", "minimum": 0 },
        "duplicateCreateProbes": { "type": "integer", "minimum": 0 },
        "duplicateFinalSubmissionProbes": { "type": "integer", "minimum": 0 },
        "sseReplayProbes": { "type": "integer", "minimum": 0 },
        "excluded": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hardwarePresent",
            "physicalControls",
            "realMicrophone",
            "realSpeech",
            "sttQuality",
            "speakerPlayback",
            "power",
            "thermal"
          ],
          "properties": {
            "hardwarePresent": { "const": false },
            "physicalControls": { "const": false },
            "realMicrophone": { "const": false },
            "realSpeech": { "const": false },
            "sttQuality": { "const": false },
            "speakerPlayback": { "const": false },
            "power": { "const": false },
            "thermal": { "const": false }
          }
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plannedTurns",
        "attemptedTurns",
        "resultTurns",
        "terminalErrorTurns",
        "stuckTurns",
        "harnessErrorTurns"
      ],
      "properties": {
        "plannedTurns": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "attemptedTurns": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "resultTurns": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "terminalErrorTurns": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "stuckTurns": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "harnessErrorTurns": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionsCreated",
        "singleFinalSessions",
        "duplicateFinalResultCount",
        "stuckSessionCount",
        "eventLossCount",
        "unexpectedSseEventCount",
        "duplicateSseEventCount",
        "ssePayloadMismatchCount",
        "sseOrderViolationCount",
        "sseReplayFailureCount",
        "sequenceGapCount",
        "receiptMismatchCount",
        "providerBoundaryViolationCount",
        "diskReceiptMissingCount",
        "orphanTempReceiptCount",
        "serverProcessFailureCount",
        "requestFailureCount"
      ],
      "properties": {
        "sessionsCreated": { "type": "integer", "minimum": 0 },
        "singleFinalSessions": { "type": "integer", "minimum": 0 },
        "duplicateFinalResultCount": { "type": "integer", "minimum": 0 },
        "stuckSessionCount": { "type": "integer", "minimum": 0 },
        "eventLossCount": { "type": "integer", "minimum": 0 },
        "unexpectedSseEventCount": { "type": "integer", "minimum": 0 },
        "duplicateSseEventCount": { "type": "integer", "minimum": 0 },
        "ssePayloadMismatchCount": { "type": "integer", "minimum": 0 },
        "sseOrderViolationCount": { "type": "integer", "minimum": 0 },
        "sseReplayFailureCount": { "type": "integer", "minimum": 0 },
        "sequenceGapCount": { "type": "integer", "minimum": 0 },
        "receiptMismatchCount": { "type": "integer", "minimum": 0 },
        "providerBoundaryViolationCount": { "type": "integer", "minimum": 0 },
        "diskReceiptMissingCount": { "type": "integer", "minimum": 0 },
        "orphanTempReceiptCount": { "type": "integer", "minimum": 0 },
        "serverProcessFailureCount": { "type": "integer", "minimum": 0 },
        "requestFailureCount": { "type": "integer", "minimum": 0 }
      }
    },
    "unavailableMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "reason"],
      "properties": {
        "availability": { "enum": ["not_collected", "unsupported", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "distribution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "unit", "sampleCount", "p50", "p95", "max", "source"],
          "properties": {
            "availability": { "const": "measured" },
            "unit": { "const": "ms" },
            "sampleCount": { "type": "integer", "minimum": 1 },
            "p50": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 },
            "max": { "type": "number", "minimum": 0 },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        { "$ref": "#/$defs/unavailableMeasurement" }
      ]
    },
    "latencyDrift": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "unit",
            "windowSize",
            "firstWindowP50",
            "lastWindowP50",
            "delta",
            "percent",
            "source"
          ],
          "properties": {
            "availability": { "const": "measured" },
            "unit": { "const": "ms" },
            "windowSize": { "type": "integer", "minimum": 1 },
            "firstWindowP50": { "type": "number", "minimum": 0 },
            "lastWindowP50": { "type": "number", "minimum": 0 },
            "delta": { "type": "number" },
            "percent": { "type": ["number", "null"] },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        { "$ref": "#/$defs/unavailableMeasurement" }
      ]
    },
    "rssMeasurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "availability",
            "unit",
            "sampleCount",
            "start",
            "end",
            "peak",
            "delta",
            "source"
          ],
          "properties": {
            "availability": { "const": "measured" },
            "unit": { "const": "bytes" },
            "sampleCount": { "type": "integer", "minimum": 1 },
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 0 },
            "peak": { "type": "integer", "minimum": 0 },
            "delta": { "type": "integer" },
            "source": { "const": "host ps RSS for spawned server PID" }
          }
        },
        { "$ref": "#/$defs/unavailableMeasurement" }
      ]
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverStartupMs",
        "turnLatencyMs",
        "manualTurnLatencyMs",
        "syntheticAudioTurnLatencyMs",
        "latencyDrift",
        "serverRss"
      ],
      "properties": {
        "serverStartupMs": { "type": "number", "minimum": 0 },
        "turnLatencyMs": { "$ref": "#/$defs/distribution" },
        "manualTurnLatencyMs": { "$ref": "#/$defs/distribution" },
        "syntheticAudioTurnLatencyMs": { "$ref": "#/$defs/distribution" },
        "latencyDrift": { "$ref": "#/$defs/latencyDrift" },
        "serverRss": { "$ref": "#/$defs/rssMeasurement" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn",
        "sessionId",
        "path",
        "outcome",
        "latencyMs",
        "finalStatus",
        "lastSequence",
        "eventCount",
        "sseEventCount",
        "recordingStartStopProbe",
        "duplicateCreateProbe",
        "duplicateFinalSubmissionProbe",
        "sseReplayProbe",
        "providers",
        "issueCodes"
      ],
      "properties": {
        "turn": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "sessionId": { "$ref": "#/$defs/safeId" },
        "path": { "enum": ["manual", "synthetic_audio"] },
        "outcome": { "enum": ["result", "terminal_error", "stuck", "harness_error"] },
        "latencyMs": { "type": "number", "minimum": 0 },
        "finalStatus": { "enum": ["result", "error", "reset", "silence", "nonterminal", "unavailable"] },
        "lastSequence": { "type": "integer", "minimum": 0 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "sseEventCount": { "type": "integer", "minimum": 0 },
        "recordingStartStopProbe": { "enum": ["passed", "failed", "not_run"] },
        "duplicateCreateProbe": { "enum": ["passed", "failed", "not_run"] },
        "duplicateFinalSubmissionProbe": { "enum": ["passed", "failed", "not_run"] },
        "sseReplayProbe": { "enum": ["passed", "failed", "not_run"] },
        "providers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stt", "tts"],
          "properties": {
            "stt": { "$ref": "#/$defs/providerObservation" },
            "tts": { "$ref": "#/$defs/providerObservation" }
          }
        },
        "issueCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safeId" }
        }
      }
    },
    "providerObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route"],
      "properties": {
        "route": {
          "enum": [
            "manual",
            "disabled",
            "local",
            "remote_batch",
            "remote",
            "not_observed"
          ]
        },
        "providerId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "outcome": {
          "enum": [
            "completed",
            "not_run",
            "provider_unavailable",
            "timed_out",
            "failed"
          ]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostSoftwareIntegrity",
        "performance",
        "hardwareReliability",
        "physicalAudioCapture",
        "sttQuality",
        "power",
        "thermal",
        "release",
        "reasons"
      ],
      "properties": {
        "hostSoftwareIntegrity": { "enum": ["pass", "fail"] },
        "performance": { "const": "not_evaluated" },
        "hardwareReliability": { "const": "not_evaluated" },
        "physicalAudioCapture": { "const": "not_evaluated" },
        "sttQuality": { "const": "not_evaluated" },
        "power": { "const": "not_evaluated" },
        "thermal": { "const": "not_evaluated" },
        "release": { "const": "not_evaluated" },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stimulus",
        "realPersonContent",
        "rawAudioRetainedByHarness",
        "serverTempAudioResidueAudited",
        "transcriptContentInSoakReceipt",
        "sessionReceiptsRetained"
      ],
      "properties": {
        "stimulus": { "const": "fixed_synthetic_text_and_generated_pcm" },
        "realPersonContent": { "const": false },
        "rawAudioRetainedByHarness": { "const": false },
        "serverTempAudioResidueAudited": { "const": false },
        "transcriptContentInSoakReceipt": { "const": false },
        "sessionReceiptsRetained": { "type": "boolean" }
      }
    }
  }
}
