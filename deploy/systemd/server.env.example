# Installed as /etc/jiko/server.env with owner root:jiko and mode 0640.
# Paths are absolute because systemd must not depend on an interactive shell.
JIKO_WRITE_RECEIPTS=1
JIKO_READY_REQUIRE_RECEIPTS=1
JIKO_READY_REQUIRE_STT=1
JIKO_READY_REQUIRE_TTS=1

FFMPEG_BIN=/usr/bin/ffmpeg
AUDIO_NORMALIZE_TIMEOUT_MS=15000
SESSION_DEADLINE_MS=4000
SESSION_RESULT_COMMIT_RESERVE_MS=750
STT_TIMEOUT_MS=15000

STT_PROVIDER=sherpa-onnx
SHERPA_ONNX_PYTHON=/opt/jiko/venv/bin/python
SHERPA_ONNX_SENSEVOICE_MODEL=/var/lib/jiko/models/sensevoice/model.onnx
SHERPA_ONNX_SENSEVOICE_TOKENS=/var/lib/jiko/models/sensevoice/tokens.txt
SHERPA_ONNX_WORKER_SCRIPT=/opt/jiko/current/apps/server/scripts/sherpa-sensevoice-worker.py
SHERPA_ONNX_LANGUAGE=auto
SHERPA_ONNX_THREADS=4
SHERPA_ONNX_PROVIDER=cpu
# Faithful transcript default. Keep ITN as a separately versioned semantic
# experiment; a 2026-09-18 synthetic host spike observed an English deletion.
SHERPA_ONNX_USE_ITN=0
SHERPA_ONNX_STARTUP_TIMEOUT_MS=60000
SHERPA_ONNX_MAX_PENDING_REQUESTS=1

TTS_PROVIDER=clip
TTS_CLIP_DIR=/opt/jiko/current/apps/server/local-clips
TTS_PLAY_AUDIO=1
TTS_PLAY_COMMAND=/usr/bin/aplay
TTS_AFTER_RESULT_DELAY_MS=900

# The supervised profile deliberately stays on loopback. The current write API
# has no authentication and is not safe to expose directly to a LAN.
DEMO_OPERATOR_KEY=
