# Installed as /etc/jiko/device.env with owner root:jiko and mode 0640.
# The unit fixes JIKO_SERVER_URL to loopback because the write API is unauthenticated.
GPIO_RECORD_BUTTON_PIN=17
BUTTON_BOUNCE_TIME=0.05
JIKO_DEVICE_OUTBOX_PATH=/var/lib/jiko-device/button-outbox.sqlite3
JIKO_DEVICE_OUTBOX_MAX_TURNS=128
JIKO_DEVICE_RETRY_BASE_SECONDS=0.25
JIKO_DEVICE_RETRY_MAX_SECONDS=5.0
